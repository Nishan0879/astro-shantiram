PORT=5000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/astro_shantiram
CORS_ORIGIN=http://localhost:3000
# Same value as the website's INTERNAL_API_KEY (any long random string)
INTERNAL_API_KEY=

# Admin dashboard: a long random string (32+ characters) that signs sign-in tokens
JWT_SECRET=
# The first admin account, created the first time it signs in (password: 10+ characters)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Optional: email notifications for new contact messages
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
CONTACT_NOTIFY_EMAIL=
